  "focus_note": "Red Dead Online only - this file tracks the Collector role (Madam Nazar's 17 collections, 184 collectible items). It does not track the single-player story. There is no Rockstar public API, so item names and set values are static game data and the only live thing a site can pull is the daily Collector cycle / Madam Nazar location (see live_data).",
  "lastUpdated": "2026-11-26",
  "live_data": {
    "note": "Rockstar does not publish a developer API and issues no API keys for RDR2/RDO. Everything below is community-maintained and needs no key.",
    "endpoints": [
      {
        "id": "cycles",
        "url": "https://api.rdo.gg/cycles",
        "returns": "Yesterday / today / tomorrow cycle number per collectible category. Cycles roll over at 00:00 UTC.",
        "used_for": "Which cycle the fixed spawns are on right now - lets the tracker show today's locations instead of guessing."
      },
      {
        "id": "nazar",
        "url": "https://api.rdo.gg/nazar",
        "returns": "Current Madam Nazar location.",
        "used_for": "Where to hand in completed sets and buy Collector maps."
      },
      {
        "id": "weekly",
        "url": "https://api.rdo.gg/weekly",
        "returns": "This week's Collector weekly request and its item keys.",
        "used_for": "Bonus-XP weekly checklist item."
      },
      {
        "id": "map_cycles_static",
        "url": "https://raw.githubusercontent.com/jeanropke/RDR2CollectorsMap/master/data/cycles.json",
        "returns": "Static cycle definitions (which item sits in which cycle slot).",
        "used_for": "Mapping a cycle number to the item that spawns today."
      },
      {
        "id": "map_locations",
        "url": "https://raw.githubusercontent.com/jeanropke/RDR2CollectorsMap/master/data/items.json",
        "returns": "Every spawn marker (lat/lng per cycle) for every item key.",
        "used_for": "Plotting spawn points. Keys here match the item ids in this file."
      }
    ],
    "no_key_note": "RDO.GG asks for no key and has no auth. If they ever add rate limits, cache /cycles for 24h rather than calling per page view."
  },
