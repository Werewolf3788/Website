  "trophies": [],
  "reference": {
    "why_no_api": {
      "answer": "Rockstar does not offer a public API, developer portal or API key for Red Dead Redemption 2 / Red Dead Online. Their backend (scapi.rockstargames.com) is internal, authenticated with a Rockstar account session, and undocumented. Any trackers built on it are scraping a logged-in session, which breaks whenever Rockstar changes the client - that is not something to put on a public site.",
      "what_to_use_instead": "The community data above: the RDO.GG API for daily cycles / Madam Nazar / weekly request, and Jean Ropke's map data for spawn coordinates. Both need no key and are maintained actively."
    },
    "how_the_role_works": {
      "unlock": "Buy the Collector's Bag from Madam Nazar (or the Roles menu once you have enough gold/tokens) to unlock the role.",
      "cycles": "Collectible spawns rotate on a daily cycle. Cycles flip at 00:00 UTC. Pull /cycles once a day and cache it - do not call it per page view.",
      "set_value": "Selling a complete set to Madam Nazar pays far more than selling the individual pieces, plus role XP. Total across all 17 collections is $4,848.50.",
      "random_spots": "Not every item has a guaranteed spawn every cycle. Items that do not appear on a fixed spot can still drop from the role's random dig sites, chests and lockboxes - that is why some sets take days.",
      "map_sell_note": "Madam Nazar moves daily; her location comes from /nazar. Collector maps sold by her mark a small set of nearby spawns for that cycle."
    },
    "data_provenance": {
      "items": "The 184 item ids, collection membership and set sell values are game data taken from the community RDR2 Collectors Map dataset (jeanropke/RDR2CollectorsMap, released under the Unlicense). Item ids are the game's own keys, so they line up with the spawn data in items.json.",
      "names": "Display names are derived from those item keys. A handful of fossil and heirloom names may differ slightly from the in-game wording - fix them here if you spot one.",
      "cross_check": "Verify against the in-game Collector bag menu or jeanropke's map before treating a name as final."
    },
    "todo": {
      "wiring": "This file is data only. To surface it on the site: add a games/rdr2.html page (clone an existing game page), set its data-game to rdr2, and add an entry to Menu.json under group Game with url #/games/rdr2.",
      "live_cycle_fetch": "Add a fetch of https://api.rdo.gg/cycles on page load and store the cycle number next to today's collectibles.",
      "trophies": "RDR2 Online has no separate trophy list, so trophies[] is empty. If you want the online achievements cross-referenced, attach trophyIds from the PSN skeleton for the RDR2 list (NPWR09309_00)."
    }
  }
}
