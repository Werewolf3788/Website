{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UniversalFirebaseUserArchitecture",
  "project_id": "entertainment-71888",
  "description": "Master user identity, friend roster synchronization, and multi-game progress telemetry pipeline.",
  "identity_resolution": {
    "auth_source": "Firebase Authentication (Google / Email)",
    "email_sanitization_rule": "email.toLowerCase().trim().replace(/@/g, '_at_').replace(/\\./g, '_')",
    "example_raw_email": "raykevin71888@gmail.com",
    "example_sanitized_key": "raykevin71888_at_gmail_com"
  },
  "realtime_database": {
    "root": "https://entertainment-71888-default-rtdb.firebaseio.com",
    "paths": {
      "/users/{emailKey}": {
        "description": "Primary user profile node keyed by sanitized email",
        "fields": {
          "avatar_source": "String ('google' | 'custom')",
          "avatar_url": "String",
          "friend_code": "String (8-character code, e.g. 'GQGI0SWY')",
          "username": "String (Display gamertag, e.g. 'Raymystro')",
          "primary_platform": "String ('ps' | 'pc' | 'xbox' | 'steam' | 'microsoft')",
          "psn_account_id": "String (Sony numeric ID)",
          "psn_username": "String (PSN tag, e.g. 'OneLIVIDMAN')",
          "psn_username_scope": "String ('public')",
          "steam_id": "String",
          "twitch_username": "String ('werewolf3788')",
          "twitch_scope": "String ('public')",
          "last_profile_sync": "Number / Timestamp",
          "updated_at": "Number / Timestamp"
        },
        "children": {
          "/friends/{FRIEND_CODE}": {
            "description": "Linked squad roster keyed by friend code (e.g. TLWWTSNU)",
            "fields": {
              "friend_code": "String ('TLWWTSNU')",
              "username": "String",
              "avatar_url": "String",
              "primary_platform": "String ('ps')",
              "email": "String",
              "linked_at": "String / Timestamp"
            }
          }
        }
      },
      "/psn/gamertags/{psn_online_id}/liveTrophyProgress/{titleId}": {
        "description": "Automated Sony PlayStation API/webhook payload store for games running live PSN sync"
      },
      "/utm_links": {
        "description": "Master navigation bar links and branding assets",
        "/Settings": "Array or map of settings dropdown items with title, url, image, rowNumber, and group"
      }
    }
  },
  "cloud_firestore": {
    "root": "Cloud Firestore / (default)",
    "paths": {
      "users/{emailKey}/platform/{platformId}/progress/{gameSlug}": {
        "description": "Per-platform deep gameplay progress document",
        "supported_platforms": ["ps", "pc", "xbox", "steam", "microsoft"],
        "example_path": "users/cartnalray9_at_gmail_com/platform/ps/progress/woth2",
        "fields": {
          "hunter_name": "String",
          "hunter_level": "Number",
          "hunter_credits": "Number",
          "five_star_kills": "Number",
          "companion_day": "Number",
          "companion_time": "String",
          "weather": "String",
          "platform": "String",
          "psn_online_id": "String",
          "psn_account_id": "String",
          "harvest_count": "Number",
          "trophies_earned": "Number",
          "trophies_total": "Number",
          "trophies_percent": "Number",
          "updatedAt": "FieldValue.serverTimestamp()",
          "dog_stats": {
            "name": "String",
            "breed": "String",
            "bonding": "Number",
            "following": "Number",
            "blood": "Number",
            "search": "Number"
          },
          "trophies": "Map<trophy_id_string, { earned: Boolean, manual: Boolean, source: String, targetValue: Number, currentValue: Number, timestamp: String }>",
          "watchlist": "Array<TargetObject>"
        }
      }
    }
  }
}
