{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PSN_RTDB_LiveTrophyProgress_Schema",
  "description": "Exact structure stored in Firebase RTDB under /psn/gamertags/{gamertag}/liveTrophyProgress/{titleId}/{trophyIndex}",
  "path_template": "/psn/gamertags/{gamertag}/liveTrophyProgress/{npCommunicationId}/{trophyIndex}",
  "example_endpoint": "/psn/gamertags/wildhorse_spirit/liveTrophyProgress/NPWR52231_00/0",
  "fields": {
    "commId": { "type": "string", "example": "NPWR52231_00" },
    "npCommunicationId": { "type": "string", "example": "NPWR52231_00" },
    "gameTitle": { "type": "string", "example": "Way of the Hunter 2" },
    "trophyId": { "type": "integer", "example": 0 },
    "title": { "type": "string", "example": "Trophy Hunter" },
    "name": { "type": "string", "example": "Trophy Hunter" },
    "description": { "type": "string", "example": "You've collected all trophies. Your dedication is admirable!" },
    "detail": { "type": "string", "example": "You've collected all trophies. Your dedication is admirable!" },
    "earned": { "type": "boolean", "example": false },
    "timestamp": { "type": ["string", "null"], "example": null },
    "trophyProgress": { "type": ["integer", "null"], "example": 0 },
    "targetValue": { "type": ["integer", "null"], "example": 0 },
    "trophyProgressTargetValue": { "type": ["integer", "null"], "example": 0 },
    "type": { "type": "string", "example": "platinum" },
    "rank": { "type": "string", "example": "platinum" },
    "rarity": { "type": ["number", "string"], "example": "0.1" },
    "earnedRate": { "type": ["number", "string"], "example": "0.1" },
    "difficultyTier": { "type": "string", "example": "Gold" },
    "hidden": { "type": "boolean", "example": true },
    "icon": { "type": "string", "example": "https://image.api.playstation.com/trophy/np/..." }
  }
}
